# Deploy the complete, versioned ERP archive at repository root.
FROM python:3.13-slim AS unpack
WORKDIR /bundle
COPY TMS-online.zip /bundle/TMS-online.zip
RUN python -m zipfile -e TMS-online.zip /unpacked

FROM node:24-bookworm-slim
WORKDIR /app
COPY --from=unpack --chown=node:node /unpacked/TMS-online/ /app/
RUN npm ci --omit=dev --ignore-scripts && mkdir -p /data && chown node:node /data
USER node
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 DATA_DIR=/data
EXPOSE 3000
CMD ["sh", "-c", "export APP_ORIGIN=\"${APP_ORIGIN:-$RENDER_EXTERNAL_URL}\"; exec node server.mjs"]
